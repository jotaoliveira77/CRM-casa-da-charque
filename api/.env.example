# Copie para .env para rodar a API fora do Docker (npm run dev).
DATABASE_URL=postgresql://crm:crm@localhost:5432/crm?schema=public
JWT_SECRET=troque-este-segredo-em-producao
PORT=3333
# Cookie de sessão só por HTTPS (deixe false em desenvolvimento)
COOKIE_SECURE=false

# Usuários criados pelo seed na primeira subida (banco vazio).
# São credenciais de desenvolvimento: troque a senha antes de usar com dados reais.
SEED_ADMIN_EMAIL=gerencia@casadacharque.local
SEED_SENHA=charque123
# true = carrega os clientes e vendas fictícios de demonstração
SEED_EXEMPLO=true
