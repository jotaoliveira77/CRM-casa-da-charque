# Copie para .env (na mesma pasta do docker-compose.yml) e troque os valores antes de usar com dados reais.

# Senha do banco PostgreSQL
POSTGRES_PASSWORD=crm

# Segredo que assina as sessões de login (pelo menos 16 caracteres, aleatório)
JWT_SECRET=troque-este-segredo-em-producao

# true quando o sistema estiver atrás de HTTPS
COOKIE_SECURE=false

# Usuário da gerência criado na primeira subida (banco vazio).
# A mesma senha vale para os vendedores de exemplo. São credenciais de desenvolvimento:
# troque a senha em Ajustes depois do primeiro acesso.
SEED_ADMIN_EMAIL=gerencia@casadacharque.local
SEED_SENHA=charque123

# true = carrega clientes e vendas fictícios de demonstração na primeira subida
SEED_EXEMPLO=true
